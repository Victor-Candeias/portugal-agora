VITE_APIABERTA_KEY=ak_your_key_here

# Postos de carregamento EV (Open Charge Map) — mesmo nome no web, no mobile e no secret do GitHub
OPEN_CHARGE_MAP_KEY=your_open_charge_map_key

# ENTSO-E Transparency Platform (energia intradiária, WEB-057). Só no build (apps/web/.env e secret
# do GitHub com o mesmo nome); nunca vai para o bundle (sem prefixo VITE_).
TRANSPARENCT_ENTSOE_TOKEN=your_entsoe_token
