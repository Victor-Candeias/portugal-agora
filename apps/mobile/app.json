{
  "expo": {
    "name": "Portugal Hoje",
    "slug": "portugal-hoje",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "portugal-hoje",
    "plugins": [
      "expo-router",
      "./plugins/withReleaseSigning",
      "@maplibre/maplibre-react-native",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#01163a",
          "image": "./assets/splash-icon.png",
          "imageWidth": 190
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "A app usa a tua localização para mostrar o que está perto de ti: pontos turísticos, hospitais, paragens e serviços públicos."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pt.portugalhoje.app"
    },
    "android": {
      "package": "pt.portugalhoje.app",
      "adaptiveIcon": {
        "backgroundColor": "#01163a",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    }
  }
}
